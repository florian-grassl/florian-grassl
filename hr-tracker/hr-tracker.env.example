# Suchbegriff wie im Portal (Firmenname ohne Anführungszeichen)
HR_SEARCH=Musterfirma
# all = alle Wörter, any = mind. ein Wort, exact = exakter Name
HR_SEARCH_MODE=all
# Optional: Treffer zusätzlich filtern (Teilstring, Groß-/Kleinschreibung egal)
HR_NAME_CONTAINS=Musterfirma OHG
HR_SITZ=

# ntfy: Server + Topic (Topic-Name möglichst unratbar wählen)
NTFY_URL=https://ntfy.sh/hr-tracker-CHANGE-ME
# Optional: Access-Token bei geschütztem Topic / eigenem Server
NTFY_TOKEN=
# Optional: ntfy leitet die Nachricht zusätzlich per Mail weiter
# (ntfy.sh: funktioniert ohne Setup; eigener Server: braucht smtp-sender-* in server.yml)
NTFY_EMAIL=

STATE_FILE=/var/lib/hr-tracker/state.json
# Nach so vielen Fehlschlägen in Folge kommt eine Warnung
FAILURE_ALERT_AFTER=3
